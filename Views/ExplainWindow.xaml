<Window x:Class="Tarjem.Views.ExplainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440">

    <Grid Margin="18">
        <Border x:Name="RootCard"
                CornerRadius="10"
                Background="#FF1E1E2E"
                BorderBrush="#18FFFFFF"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="RootTranslate" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.20" Color="Black"/>
            </Border.Effect>

            <StackPanel Margin="18,15,18,16">

                <!-- Source line: what this is, and where the answer came from -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ABOUT"
                               x:Name="KindLabel"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF8888AA"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               x:Name="SourceChip"
                               FontSize="10.5"
                               Foreground="#FF8888AA"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- The name itself -->
                <TextBlock x:Name="TitleText"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="#FFFFFFFF"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2"/>

                <!-- Wikidata/Wikipedia's short descriptor, e.g. "American technology company" -->
                <TextBlock x:Name="DescriptorText"
                           FontSize="12"
                           Foreground="#FF9F7AEA"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,8"/>

                <!-- The summary, in the source language -->
                <TextBlock x:Name="SummaryText"
                           FontSize="13"
                           LineHeight="19"
                           Foreground="#FFDDDDDD"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

                <Border x:Name="TranslationDivider"
                        Height="1"
                        Background="#FF3A3A4A"
                        Margin="0,13,0,11"
                        Visibility="Collapsed"/>

                <!-- The same summary in the user's language -->
                <TextBlock x:Name="TranslatedSummaryText"
                           FontSize="13.5"
                           LineHeight="21"
                           Foreground="#FFEEEEEE"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- Loading state -->
                <TextBlock x:Name="LoadingText"
                           Text="Looking it up…"
                           FontSize="13"
                           Foreground="#FF8888AA"
                           Visibility="Collapsed"
                           Margin="0,6,0,0"/>

                <!-- Actions -->
                <StackPanel x:Name="ActionRow"
                            Orientation="Horizontal"
                            Margin="0,14,0,0">
                    <Button x:Name="CopyButton"
                            Content="Copy"
                            Padding="10,4"
                            FontSize="11.5"
                            Background="#FF2A2A3A"
                            Foreground="#FFDDDDDD"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Copy_Click"/>
                    <Button x:Name="SourceButton"
                            Content="Read more"
                            Margin="8,0,0,0"
                            Padding="10,4"
                            FontSize="11.5"
                            Background="#FF2A2A3A"
                            Foreground="#FFDDDDDD"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="Source_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
