<Window x:Class="Tarjem.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarjem"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        MaxWidth="440"
        MinHeight="100"
        Left="0"
        Top="0">
    <Window.Resources>
        <Style x:Key="SourceComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SourceComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Width="18" Height="18">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ToolTip="{TemplateBinding Tag}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBg" Background="Transparent" CornerRadius="4" Width="18" Height="18">
                                            <Path x:Name="Arrow"
                                                  Data="M1,2 L5,6.5 L9,2"
                                                  Stroke="#FF888888"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBg" Property="Background" Value="#FF3A3A4A"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#FFDDDDDD"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleBg" Property="Background" Value="#FF4A4A5C"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M1,6.5 L5,2 L9,6.5"/>
                                                <Setter TargetName="ToggleBg" Property="Background" Value="#FF3A3A4A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   HorizontalOffset="-4"
                                   VerticalOffset="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="PopupBorder"
                                        Background="#FF2A2A3A"
                                        BorderBrush="#FF3A3A4A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="2"
                                        MinWidth="130"
                                        RenderTransformOrigin="0.5,0">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PopupScale" ScaleX="1" ScaleY="0.85"/>
                                            <TranslateTransform x:Name="PopupTranslate" Y="-6"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootCard"
            Background="#FF1E1E2E"
            CornerRadius="12"
            BorderThickness="0"
            Margin="4"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="0.94" ScaleY="0.94"/>
                <TranslateTransform x:Name="RootTranslate" Y="8"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow"
                              BlurRadius="28"
                              ShadowDepth="6"
                              Opacity="0.22"
                              Color="Black"
                              Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Accent stripe -->
            <Border x:Name="AccentStripe"
                    Grid.Row="0"
                    Height="3"
                    Background="#FF7C3AED"
                    CornerRadius="12,12,0,0"/>

            <!-- Translation section -->
            <Border x:Name="TranslationSection" Grid.Row="1" Padding="16,10,16,10" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="TranslationSourceCombo"
                                      Style="{StaticResource SourceCombo}"
                                      SelectedIndex="0"
                                      SelectionChanged="TranslationSourceCombo_SelectionChanged"/>
                            <TextBlock x:Name="TranslationHeader"
                                       Text="Translation"
                                       Foreground="#FF888888"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Image x:Name="GeminiStar1"
                                   Source="pack://application:,,,/Tarjem;component/Assets/sparkling-star.png"
                                   Width="10" Height="10"
                                   Margin="5,0,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"/>
                        </StackPanel>

                        <Button x:Name="CopyTranslationBtn"
                                Grid.Column="2"
                                Width="20" Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Copy"
                                Click="CopyTranslation_Click">
                            <TextBlock Text="&#x1F4CB;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <RichTextBox x:Name="TranslatedSentenceBox"
                                 Grid.Row="2"
                                 FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                 FontSize="13.5"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,0,0,2"
                                 Margin="0"/>
                </Grid>
            </Border>

            <!-- Divider -->
            <Border x:Name="Divider" Grid.Row="2" Background="#FF3A3A4A" Height="1"/>

            <!-- Meaning section -->
            <Border x:Name="DictionarySection" Grid.Row="3" Padding="16,10,16,12" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="DictionarySourceCombo"
                                      Style="{StaticResource SourceCombo}"
                                      SelectedIndex="0"
                                      SelectionChanged="DictionarySourceCombo_SelectionChanged"/>
                            <TextBlock x:Name="MeaningHeader"
                                       Text="Meaning"
                                       Foreground="#FF888888"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Image x:Name="GeminiStar2"
                                   Source="pack://application:,,,/Tarjem;component/Assets/sparkling-star.png"
                                   Width="10" Height="10"
                                   Margin="5,0,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"/>
                        </StackPanel>

                        <Button x:Name="CopyWordBtn"
                                Grid.Column="2"
                                Width="20" Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Copy"
                                Click="CopyWord_Click">
                            <TextBlock Text="&#x1F4CB;" FontSize="10"/>
                        </Button>
                    </Grid>

                    <!-- Headword on the left, its one-word translation pinned to the right edge.
                         They used to sit side by side with a dot between them, which read as one
                         run-on phrase; separating them across the row makes it obvious which is
                         the word and which is the answer. -->
                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="OriginalWordText"
                                   Grid.Column="0"
                                   Foreground="#FFFFFFFF"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button x:Name="CopyWordInlineBtn"
                                Grid.Column="1"
                                Width="20" Height="20"
                                Margin="5,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Copy"
                                Click="CopyWord_Click">
                            <TextBlock Text="&#x1F4CB;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Kept in the tree but never shown: the separator only made sense when
                             the two words were adjacent. -->
                        <TextBlock x:Name="WordSeparator"
                                   Grid.Column="2"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="InlineWordTranslationText"
                                   Grid.Column="3"
                                   Foreground="#FF9F7AEA"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- Badges row -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CefrBadge"
                                Grid.Column="0"
                                Background="#FF7C3AED"
                                CornerRadius="4"
                                Padding="5,2"
                                Margin="0,0,5,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="CefrLevelText"
                                       Foreground="White"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>

                        <TextBlock x:Name="PhoneticText"
                                   Grid.Column="1"
                                   Foreground="#FF888888"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <Border x:Name="PosBadge"
                                Grid.Column="2"
                                Background="#FF3A3A4A"
                                CornerRadius="4"
                                Padding="5,2"
                                Margin="0,0,5,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="PartOfSpeechText"
                                       Foreground="#FFBBBBBB"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <!-- Definition -->
                    <TextBlock Grid.Row="6"
                               x:Name="MeaningText"
                               Foreground="#FFDDDDDD"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               LineHeight="18"/>

                    <!-- Synonyms, or - when the answer came from an encyclopedia rather than a
                         dictionary - the attribution those sources require. Same row, since the
                         two never appear together. -->
                    <TextBlock Grid.Row="8"
                               x:Name="SynonymsText"
                               Foreground="#FF888888"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
