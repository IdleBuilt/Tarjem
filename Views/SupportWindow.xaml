<ui:FluentWindow x:Class="Tarjem.Views.SupportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Support Tarjem"
                 Width="460"
                 SizeToContent="Height"
                 MinHeight="380"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Loaded="SupportWindow_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Support Tarjem" ShowMaximize="False" ShowMinimize="False"/>

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="28,4,28,26" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96"/>
            </Grid.RenderTransform>

            <StackPanel>

                <!-- The thank-you comes first and unconditionally. Nobody should have to scroll
                     past an ask to find out they were appreciated. -->
                <TextBlock Text="&#x2665;"
                           FontSize="32"
                           Foreground="#FFE05C7A"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,10"/>

                <TextBlock x:Name="ThanksHeadline"
                           Text="Thank you for using Tarjem"
                           FontSize="19"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="ThanksBody"
                           FontSize="13"
                           Opacity="0.8"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,10,0,0"/>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Tarjem is free, and stays free"
                                   FontSize="13"
                                   FontWeight="Medium"/>
                        <TextBlock Text="No account, no subscription, no ads, and nothing you look up ever leaves your machine except the word itself. That isn't changing."
                                   FontSize="12.5"
                                   Opacity="0.8"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Shown only once there is somewhere for the money to go. Until then the
                     window is purely a thank-you, because a donate button that goes nowhere is
                     worse than no donate button. -->
                <StackPanel x:Name="DonatePanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <ui:Button x:Name="DonateButton"
                               Content="Buy me a coffee"
                               Icon="{ui:SymbolIcon Heart24}"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Click="DonateButton_Click"/>
                    <TextBlock Text="Opens in your browser. Any amount, once - never a subscription."
                               FontSize="11.5"
                               Opacity="0.65"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- What to do instead, when there is nothing to donate to yet - and honestly the
                     more useful ask either way. -->
                <StackPanel x:Name="OtherWaysPanel" Margin="0,18,0,0">
                    <TextBlock x:Name="OtherWaysHeader"
                               Text="If you'd like to help"
                               FontSize="13"
                               FontWeight="Medium"
                               Margin="0,0,0,8"/>

                    <ui:Button x:Name="StarButton"
                               Content="Star the project on GitHub"
                               Icon="{ui:SymbolIcon Star24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,6"
                               Click="StarButton_Click"/>

                    <ui:Button x:Name="FeedbackButton"
                               Content="Report a bug or suggest something"
                               Icon="{ui:SymbolIcon Chat24}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Click="FeedbackButton_Click"/>
                </StackPanel>

                <ui:Button x:Name="CloseButton"
                           Content="Close"
                           Appearance="Transparent"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"
                           Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
