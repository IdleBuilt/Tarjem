<ui:FluentWindow x:Class="Tarjem.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Welcome to Tarjem"
        Width="1200"
        Height="750"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Loaded="WelcomeWindow_Loaded">

    <ui:FluentWindow.Resources>
        <!-- Language row: flag + name. Shared by every language picker in the app. -->
        <DataTemplate x:Key="LanguageItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Flag}"
                       Width="22" Height="16"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <ui:TitleBar VerticalAlignment="Top"
                     Panel.ZIndex="1"
                     Title="Welcome"
                     ShowMinimize="False"
                     ShowMaximize="False"/>

        <Grid x:Name="RootGrid" Opacity="0" RenderTransformOrigin="0.5,0.5" Margin="0,32,0,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RootTranslate" Y="14"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="40,18,40,20" HorizontalAlignment="Center">
                <ui:ImageIcon Source="pack://application:,,,/Tarjem;component/Assets/icon.ico"
                              Width="44" Height="44" HorizontalAlignment="Center"/>
                <TextBlock Text="Welcome to Tarjem"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Two columns: choices on the left, live status on the right -->
            <Grid Grid.Row="1" Margin="40,0,40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left: languages + shortcuts ── -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Languages" Style="{StaticResource Heading}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Reading" FontSize="11.5" Opacity="0.7" Margin="2,0,0,5"/>
                                <ComboBox x:Name="SourceLanguageCombo"
                                          HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource LanguageItemTemplate}"
                                          SelectionChanged="LanguagePair_SelectionChanged"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="&#x2192;" FontSize="16"
                                       VerticalAlignment="Bottom" Margin="12,0,12,7" Opacity="0.6"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Into" FontSize="11.5" Opacity="0.7" Margin="2,0,0,5"/>
                                <ComboBox x:Name="TargetLanguageCombo"
                                          HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource LanguageItemTemplate}"
                                          SelectionChanged="LanguagePair_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LanguagePackWarningText"
                                   Foreground="#FFE0A030"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="2,10,0,0"/>

                        <TextBlock Text="Shortcuts" Style="{StaticResource Heading}" Margin="0,26,0,10"/>

                        <ui:CardControl Margin="0,0,0,8" Padding="14,10">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Translate a word" FontWeight="Medium"/>
                                    <TextBlock Text="The word under your cursor" FontSize="11.5" Opacity="0.7" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="WordHotkeyButton" MinWidth="130"
                                       HorizontalContentAlignment="Center"
                                       Click="WordHotkeyButton_Click"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8" Padding="14,10">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Translate a region" FontWeight="Medium"/>
                                    <TextBlock Text="Drag a box around anything" FontSize="11.5" Opacity="0.7" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="RegionHotkeyButton" MinWidth="130"
                                       HorizontalContentAlignment="Center"
                                       Click="RegionHotkeyButton_Click"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8" Padding="14,10">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="What is this?" FontWeight="Medium"/>
                                    <TextBlock Text="Names no dictionary carries" FontSize="11.5" Opacity="0.7" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="ExplainHotkeyButton" MinWidth="130"
                                       HorizontalContentAlignment="Center"
                                       Click="ExplainHotkeyButton_Click"/>
                        </ui:CardControl>

                        <TextBlock x:Name="HotkeyStatusText"
                                   FontSize="11.5" Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="2,4,0,0"
                                   Text="Click a shortcut to change it."/>

                        <ui:CardControl Margin="0,22,0,0" Padding="14,10">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Translate what you copy" FontWeight="Medium"/>
                                    <TextBlock Text="Copy any text and a Tarjem button appears next to your cursor"
                                               FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="SelectionPopupToggle"/>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Right: does any of this actually work ── -->
                <Border Grid.Column="2"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Your setup" Style="{StaticResource Heading}" Margin="0"/>
                            <ui:Button x:Name="TestSetupButton"
                                       Content="Test all"
                                       Appearance="Primary"
                                       HorizontalAlignment="Right"
                                       Padding="14,5"
                                       Click="TestSetupButton_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="StatusList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Glyph}"
                                                       Foreground="{Binding Color}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11" Opacity="0.65"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding DetailVisibility}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Timing}"
                                                       FontSize="11" Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock x:Name="AdvancedSummaryText"
                                       FontSize="11.5" Opacity="0.75"
                                       TextWrapping="Wrap"/>

                            <ToggleButton x:Name="AdvancedToggle"
                                          Content="Choose sources manually"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Left"
                                          Cursor="Hand"
                                          Margin="0,8,0,0"
                                          Padding="0"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Checked="AdvancedToggle_Changed"
                                          Unchecked="AdvancedToggle_Changed"/>

                            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Definitions" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DictionaryProviderCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="AdvancedProvider_SelectionChanged"/>

                                <TextBlock Text="Translation" FontSize="11" Opacity="0.7" Margin="0,10,0,4"/>
                                <ComboBox x:Name="TranslationProviderCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="AdvancedProvider_SelectionChanged"/>

                                <TextBlock x:Name="KeySignupText"
                                           FontSize="11" Opacity="0.7"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Margin="0,10,0,4"/>
                                <ui:TextBox x:Name="AdvancedApiKeyBox"
                                            HorizontalAlignment="Stretch"
                                            Visibility="Collapsed"
                                            PlaceholderText="Paste an API key"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="40,20,40,26">
                <Button x:Name="SkipButton"
                        Content="Skip"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Click="SkipButton_Click"/>

                <ui:Button x:Name="GetStartedButton"
                           Content="Get started"
                           Appearance="Primary"
                           HorizontalAlignment="Right"
                           MinWidth="200"
                           Padding="0,11"
                           HorizontalContentAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Click="GetStartedButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
